# Node Environment
NODE_ENV=development
PORT=5001

# Frontend URL for restricted CORS (can be comma-separated)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String (Fill in your own credentials)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/srimanasa_tests?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication
# Generate a secure 64-character random string (e.g., run `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Admin Seed Credentials (used by npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@srimanasa.com
ADMIN_PASSWORD=change_this_secure_password
